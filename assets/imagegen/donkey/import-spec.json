  "notes": {
    "material": "Every native opaque pixel is sampled from built-in image-generation PNGs; transforms only mirror or shift complete imported frames.",
    "fallback": "Native source frame-map coverage must be zero missing before declaring migration complete.",
    "walk": "Six native walk phases retain their timing and use four distinct drawings in symmetric contact/passing order. Front/back walks add existing stride drawings; side walks mirror the two source-right contacts to complete the left-facing cycle.",
    "orientationCorrections": [
      "Story cell3 is right-facing look-back; mirrored for left.",
      "Story cell6 is right-facing startle; mirrored for left.",
      "Gestures cell11 is right-facing inspect; mirrored for left."
    ],
    "phaseReuse": "Actual generated pose changes retain native animation timing. Cosmetic whole-sprite one-pixel jitter is omitted to avoid duplicating8×8 tiles; cartridge movement/jump trajectories remain native.",
    "proportions": "NativeHeight29 and horizontal source-only resampling1.2 improve landmark readability; explicit wide/tall-action exceptions preserve source geometry without clipping.",
    "materialRemap": "Sampling reference separates warm-gray fur from saturated brown leather/brass. Output/ROM retains the unchanged cast palette; indices2/3/4 are gray fur,6/7 leather,11 brass,12 steel.",
    "nativeMirrors": "Right-facing roles reuse the generated left-facing pixels through native horizontal mirroring, matching the cartridge sprite convention and avoiding duplicate tiles. Explicit source-right drawings remain archived for review."
  },
