  "notes": {
    "material": "Every imported opaque pixel is sampled from a saved built-in image-generation PNG; no procedural anatomy is added to these source frames.",
    "timing": "The source cartridge animation lists, frame counts, timing and intentional blanks are preserved. Repeated source poses retain native phase slots; only full-frame mirroring is used.",
    "coverage": "Only generated poses with matching visible action and direction are mapped. Unmapped roles remain the earlier artwork and are enumerated in coverage.json. This is a partial raster migration.",
    "nativeMirrors": "Right-facing roles mirror the generated left-facing pixels to use native tile sharing. Explicit source-right drawings remain archived for review.",
    "missingSources": "No native nonblank frame remains uncovered after the directional and finishing source sheets. All255native frames, including five intentional blanks, still require native upload verification.",
    "orientationCorrections": [
      "Story cell11 is right-facing kiss despite the requested left direction; mirrored for left.",
      "Directions cell11 is right-facing laugh and is mirrored for left. Directions cells5,14,15 face front and are not used for left-facing roles; strict profile versions come from finishing cells12,13,14."
    ],
    "materialRemap": "Purple source gumdrops are mapped explicitly to existing palette indices6/7, so they remain distinct from baked cookie shading. Output retains the current native palette.",
    "proportions": "Native30pixel ordinary standing height with full-silhouette32pixel exceptions; complete PNG silhouettes remain inside the native32×32 frame.",
    "blink": "Rear blink reuses rear idle because eyes are not visible from behind; every other visible action has a matching generated source silhouette."
  }
