  "notes": {
    "material": "Every native opaque pixel is sampled from built-in image-generation PNGs; transforms only mirror or shift complete imported frames.",
    "fallback": "Native source frame-map coverage must be zero missing before declaring migration complete.",
    "walk": "Six native phases retain their timing and use four distinct drawings in symmetric contact/passing order. Front/back walks add existing neutral passing drawings; side walks mirror the two source-right contacts to complete the left-facing cycle.",
    "orientationCorrections": [
      "Story cell3 is right-facing arms-folded; mirrored for left.",
      "Finishing cell11 is right-facing inverted; mirrored for left.",
      "Broad combat cell11 is right-facing airborne crossbow; mirrored for left."
    ],
    "phaseReuse": "Actual generated pose changes retain native animation timing. Cosmetic whole-sprite one-pixel jitter is omitted to avoid duplicating8×8 tiles; cartridge movement/jump trajectories remain native.",
    "proportions": "Selected broad-ogre generation targets a 10-pixel face, fuller shoulders/hips and temple ears. Five sheets share this identity. Standing reference height is 29 except the combat sheet uses a shared 28 to preserve its overhead arm/weapon extent; no horizontal widening except the explicit wide-action fit.",
    "nativeMirrors": "Right-facing roles reuse the generated left-facing pixels through native horizontal mirroring, matching the cartridge sprite convention and avoiding duplicate tiles. Explicit source-right drawings remain archived for review."
  }
