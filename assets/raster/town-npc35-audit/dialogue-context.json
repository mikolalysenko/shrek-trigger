  "scenes": [
    {
      "location": 4,
      "name": "Lucca's Workshop",
      "stringTables": [
        {
          "address": 16162816,
          "offset": 3579904
        }
      ],
      "objects": [
        {
          "object": 8,
          "npc": [
            39
          ],
          "texts": [
            {
              "id": 9,
              "tablePointerOffset": 3579922,
              "offset": 3580497,
              "bytes": 15,
              "text": "TABAN: Hey, {Donkey}!"
            },
            {
              "id": 7,
              "tablePointerOffset": 3579918,
              "offset": 3580443,
              "bytes": 24,
              "text": "TABAN: You're {Donkey}'s friend right?"
            },
            {
              "id": 8,
              "tablePointerOffset": 3579920,
              "offset": 3580467,
              "bytes": 30,
              "text": "   If you see {Donkey}, tell her to drop{br}by!"
            },
            {
              "id": 10,
              "tablePointerOffset": 3579924,
              "offset": 3580512,
              "bytes": 56,
              "text": "TABAN: I'd like to see more of her.{br}I've been making items she'd like."
            },
            {
              "id": 11,
              "tablePointerOffset": 3579926,
              "offset": 3580568,
              "bytes": 24,
              "text": "TABAN: Oh you're just in time."
            },
            {
              "id": 0,
              "tablePointerOffset": 3579904,
              "offset": 3580116,
              "bytes": 21,
              "text": "{br}         You got 1 {item}!"
            },
            {
              "id": 12,
              "tablePointerOffset": 3579928,
              "offset": 3580592,
              "bytes": 52,
              "text": "TABAN: It's my finest work!{br}The ultimate in defense for my,{br}daughter!"
            },
            {
              "id": 30,
              "tablePointerOffset": 3579964,
              "offset": 3581454,
              "bytes": 57,
              "text": "TABAN: Take a look {Donkey}!{br}I borrowed a bit of the Sun Stone to{br}create something nifty!"
            }
          ]
        }
      ]
    },
    {
      "location": 8,
      "name": "Telepod Exhibit",
      "stringTables": [
        {
          "address": 16327086,
          "offset": 3744174
        }
      ],
      "objects": [
        {
          "object": 10,
          "npc": [
            39
          ],
          "texts": [
            {
              "id": 111,
              "tablePointerOffset": 3744396,
              "offset": 3745502,
              "bytes": 19,
              "text": "BAKER: What do we do?"
            },
            {
              "id": 84,
              "tablePointerOffset": 3744342,
              "offset": 3744715,
              "bytes": 54,
              "text": "BAKER: It worked!{br}Precisely as we intended!{br}Please ignore my surprise."
            },
            {
              "id": 82,
              "tablePointerOffset": 3744338,
              "offset": 3744599,
              "bytes": 41,
              "text": "BAKER: A volunteer!{br}Shrek, the platform is reinforced."
            },
            {
              "id": 83,
              "tablePointerOffset": 3744340,
              "offset": 3744640,
              "bytes": 75,
              "text": "BAKER: We tested it on an onion.{br}It arrived in one piece.{br}Mostly the same piece.{page}Please step up!"
            },
            {
              "id": 79,
              "tablePointerOffset": 3744332,
              "offset": 3744441,
              "bytes": 67,
              "text": "BAKER: Step up! Donkey presents{br}a machine that will make{br}walking almost unnecessary!"
            },
            {
              "id": 80,
              "tablePointerOffset": 3744334,
              "offset": 3744508,
              "bytes": 26,
              "text": "BAKER: Start on this platform..."
            },
            {
              "id": 81,
              "tablePointerOffset": 3744336,
              "offset": 3744534,
              "bytes": 65,
              "text": "BAKER: ...and arrive over there!{br}Donkey built it. I supplied{br}the heatproof parts."
            },
            {
              "id": 94,
              "tablePointerOffset": 3744362,
              "offset": 3745023,
              "bytes": 58,
              "text": "BAKER: Our next volunteer!{br}Please keep all royal jewelry{br}inside the machine."
            },
            {
              "id": 98,
              "tablePointerOffset": 3744370,
              "offset": 3745153,
              "bytes": 42,
              "text": "BAKER: A round of applause{br}when she returns, please!"
            },
            {
              "id": 99,
              "tablePointerOffset": 3744372,
              "offset": 3745195,
              "bytes": 18,
              "text": "BAKER: Power is ready!"
            },
            {
              "id": 106,
              "tablePointerOffset": 3744386,
              "offset": 3745337,
              "bytes": 23,
              "text": "BAKER: Donkey! Where is she?"
            },
            {
              "id": 108,
              "tablePointerOffset": 3744390,
              "offset": 3745360,
              "bytes": 41,
              "text": "BAKER: The show is over!{br}Please leave in an orderly panic."
            },
            {
              "id": 109,
              "tablePointerOffset": 3744392,
              "offset": 3745401,
              "bytes": 36,
              "text": "BAKER: That was not a landing!{br}Where did you send her?"
            },
            {
              "id": 114,
              "tablePointerOffset": 3744402,
              "offset": 3745569,
              "bytes": 44,
              "text": "BAKER: You are going after her?{br}Then hold on to that pendant."
            }
          ]
        }
      ]
    },
    {
      "location": 9,
      "name": "Lara's Room",
      "stringTables": [
