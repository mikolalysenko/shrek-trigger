    {
      "location": 115,
      "name": "Truce Smithy's Residence",
      "stringTables": [
        {
          "address": 16246756,
          "offset": 3663844
        }
      ],
      "objects": [
        {
          "object": 9,
          "npc": [
            52
          ],
          "texts": [
            {
              "id": 156,
              "tablePointerOffset": 3664156,
              "offset": 3664229,
              "bytes": 63,
              "text": "SMITH: Alder asked me to forge{br}a bell for Queen Elowen.{br}A voice worthy of the square."
            },
            {
              "id": 157,
              "tablePointerOffset": 3664158,
              "offset": 3664292,
              "bytes": 67,
              "text": "SMITH: I could not work while{br}the queen was missing.{br}Now every strike sounds hopeful."
            },
            {
              "id": 159,
              "tablePointerOffset": 3664162,
              "offset": 3664422,
              "bytes": 60,
              "text": "SMITH: The bell is nearly done.{br}But with Alder wounded,{br}I have no heart for its song."
            },
            {
              "id": 190,
              "tablePointerOffset": 3664224,
              "offset": 3664525,
              "bytes": 82,
              "text": "SMITH: The bell is at the castle!{br}And the fighting has stopped.{full}Tonight, we raise our glasses{br}to the people who came home."
            }
          ]
        }
      ]
    },
    {
      "location": 116,
      "name": "Truce Inn 1F (Middle Ages)",
      "stringTables": [
        {
          "address": 13945380,
          "offset": 1362468
        }
      ],
      "objects": [
        {
          "object": 12,
          "npc": [
            52
          ],
          "texts": [
            {
              "id": 136,
              "tablePointerOffset": 1362740,
              "offset": 1362876,
              "bytes": 46,
              "text": "A festival? Here?{br}You have arrived several{br}hundred years too early."
            },
            {
              "id": 185,
              "tablePointerOffset": 1362838,
              "offset": 1363862,
              "bytes": 70,
              "text": "The bearer of the Hero Badge{br}went to see King Alder.{full}I hope the boy understands{br}how much we need him."
            },
            {
              "id": 195,
              "tablePointerOffset": 1362858,
              "offset": 1364077,
              "bytes": 36,
              "text": "Come on, dance!{br}We have earned an awkward jig."
            }
          ]
        },
        {
          "object": 15,
          "npc": [
            52
          ],
          "texts": [
            {
              "id": 141,
              "tablePointerOffset": 1362750,
              "offset": 1363089,
              "bytes": 66,
              "text": "Farquaad broke Zenan Bridge.{br}Until it is repaired, there is{br}no way to the southern continent."
            },
            {
              "id": 182,
              "tablePointerOffset": 1362832,
              "offset": 1363757,
              "bytes": 39,
              "text": "Farquaad has taken the bridge?{br}Then the castle is next."
            },
            {
              "id": 192,
              "tablePointerOffset": 1362852,
              "offset": 1363948,
              "bytes": 52,
              "text": "To our heroes!{br}To everyone who held on!{br}To an evening without bad news!"
            }
          ]
        }
      ]
    },
    {
      "location": 125,
      "name": "Castle Magus Doppleganger Corridor",
      "stringTables": [
        {
          "address": 16206560,
          "offset": 3623648
        }
      ],
      "objects": [
        {
          "object": 13,
          "npc": [
            39
          ],
          "texts": [
            {
              "id": 46,
              "tablePointerOffset": 3623740,
              "offset": 3637887,
              "bytes": 16,
              "text": "Well, if it isn't {Donkey}!"
            },
            {
              "id": 47,
              "tablePointerOffset": 3623742,
              "offset": 3637903,
              "bytes": 24,
              "text": "You're STILL alive, my dear?!"
            }
          ]
        }
      ]
    },
    {
      "location": 138,
      "name": "Sandorino Inn",
      "stringTables": [
        {
          "address": 14443328,
          "offset": 1860416
        }
      ],
      "objects": [
        {
          "object": 14,
          "npc": [
            52
          ],
          "texts": [
            {
              "id": 93,
              "tablePointerOffset": 1860602,
              "offset": 1861626,
              "bytes": 73,
              "text": "INNKEEPER: Looking for the hero?{br}Try Porre, the village to the south.{br}That is where the boy comes from."
            },
            {
              "id": 94,
              "tablePointerOffset": 1860604,
              "offset": 1861699,
              "bytes": 55,
              "text": "INNKEEPER: The hero went to{br}Denadoro for the hatchet.{br}I hope the boy is all right."
            },
            {
              "id": 95,
              "tablePointerOffset": 1860606,
              "offset": 1861754,
              "bytes": 64,
              "text": "INNKEEPER: Farquaad is gone!{page}Open the shutters!{br}I want this place full of laughter!"
            }
          ]
        }
      ]
    },
    {
      "location": 152,
      "name": "Tata's House 1F",
      "stringTables": [
        {
          "address": 14607104,
          "offset": 2024192
        }
      ],
      "objects": [
        {
          "object": 8,
          "npc": [
            39
          ],
          "texts": [
            {
              "id": 73,
              "tablePointerOffset": 2024338,
              "offset": 2027389,
              "bytes": 79,
              "text": "How could I have fallen for that? For{br}my dear departed wife's sake, I vow{br}to keep my feet on the ground!"
            },
            {
              "id": 69,
              "tablePointerOffset": 2024330,
              "offset": 2027085,
              "bytes": 67,
              "text": "My son's the legendary Hero!{br}It must have been all that oatmeal!{br}And to think that I'm his father…!"
            }
          ]
        }
      ]
    },
    {
      "location": 155,
      "name": "Porre Cafe (Middle Ages)",
      "stringTables": [
        {
          "address": 16157186,
          "offset": 3574274
        }
      ],
      "objects": [
        {
          "object": 16,
          "npc": [
            52
          ],
          "texts": [
            {
              "id": 176,
              "tablePointerOffset": 3574626,
              "offset": 3575195,
              "bytes": 49,
              "text": "I can't believe the legendary Hero was{br}a boy from this village!"
            },
            {
              "id": 177,
              "tablePointerOffset": 3574628,
              "offset": 3575244,
              "bytes": 31,
              "text": "Did you hear the latest?{br}   Yes.{br}   No."
            },
            {
              "id": 178,
              "tablePointerOffset": 3574630,
              "offset": 3575275,
              "bytes": 42,
              "text": "Everyone's talking about him!{br}I bet his old man is proud!"
            },
            {
              "id": 179,
              "tablePointerOffset": 3574632,
              "offset": 3575317,
              "bytes": 45,
              "text": "Well, remember that the legendary{br}Hero is from this village then!"
            },
            {
              "id": 180,
              "tablePointerOffset": 3574634,
              "offset": 3575362,
              "bytes": 37,
              "text": "And I thought the Hero was from here.{br}What a let down…"
            }
          ]
        }
      ]
    },
    {
      "location": 186,
      "name": "Choras Carpenter's Residence 1F (Middle Ages)",
      "stringTables": [
        {
          "address": 16271952,
          "offset": 3689040
        }
      ],
      "objects": [
        {
          "object": 8,
          "npc": [
            52
          ],
          "texts": [
            {
              "id": 88,
              "tablePointerOffset": 3689216,
              "offset": 3710181,
              "bytes": 12,
              "text": "That's it for now."
            },
            {
              "id": 85,
              "tablePointerOffset": 3689210,
              "offset": 3710026,
              "bytes": 56,
              "text": "You want the Northern Ruins repaired?{br}It'll cost you 2000 G.{br}   Yes{br}   No"
            },
            {
              "id": 87,
              "tablePointerOffset": 3689214,
              "offset": 3710109,
              "bytes": 72,
              "text": "We can't repair the spots where the{br}monsters hide.{br}Call us after you get rid of them.{br}We'll do the rest."
            },
            {
              "id": 86,
              "tablePointerOffset": 3689212,
              "offset": 3710082,
              "bytes": 27,
              "text": "It ain't gonna happen without the cash."
            },
            {
              "id": 83,
              "tablePointerOffset": 3689206,
              "offset": 3709919,
              "bytes": 74,
