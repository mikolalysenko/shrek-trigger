          "offset": 3584560
        }
      ],
      "objects": [
        {
          "object": 40,
          "npc": [
            39
          ],
          "texts": [
            {
              "id": 60,
              "tablePointerOffset": 3584680,
              "offset": 3586971,
              "bytes": 37,
              "text": "TABAN: Yum!{br}Lemonade sure tastes great{br}outdoors!"
            },
            {
              "id": 61,
              "tablePointerOffset": 3584682,
              "offset": 3587008,
              "bytes": 34,
              "text": "TABAN: {Shrek}, have a sip!{br}You're the Hero today."
            }
          ]
        }
      ]
    },
    {
      "location": 81,
      "name": "Leene Square (Ending: Moonlight Parade)",
      "stringTables": [
        {
          "address": 16167472,
          "offset": 3584560
        }
      ],
      "objects": [
        {
          "object": 10,
          "npc": [
            39
          ],
          "texts": [
            {
              "id": 139,
              "tablePointerOffset": 3584838,
              "offset": 3589880,
              "bytes": 97,
              "text": "TABAN: Phew!{br}Made it just in time!{br}Shall I fire one off?{delay 10}{instant}KING: Uh, no Taban.{br}Actually, I could really use your help…{delay 6}{delay 0}"
            }
          ]
        }
      ]
