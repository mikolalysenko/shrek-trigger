              "bytes": 26,
              "text": "TABAN: Here's what we earned today!"
            },
            {
              "id": 6,
              "tablePointerOffset": 3579916,
              "offset": 3580424,
              "bytes": 19,
              "text": "LARA: You're so thoughtful."
            }
          ]
