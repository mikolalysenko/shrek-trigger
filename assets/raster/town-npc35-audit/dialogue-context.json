    {
      "location": 50,
      "name": "Porre Mayor's Manor 1F (Present)",
      "stringTables": [
        {
          "address": 14607104,
          "offset": 2024192
        }
      ],
      "objects": [
        {
          "object": 8,
          "npc": [
            25
          ],
          "texts": [
            {
              "id": 114,
              "tablePointerOffset": 2024420,
              "offset": 2028861,
              "bytes": 86,
              "text": "You're interested in the Moon Stone?{br}Well, someone simply left it here.{full}Seems important to you folks.{br}Why don't you take it!"
            },
            {
              "id": 31,
              "tablePointerOffset": 2024254,
              "offset": 2025306,
              "bytes": 61,
              "text": "Share and share alike!{br}Help the needy!{br}Thinkin' about makin' THAT the town{br}motto."
            },
            {
              "id": 115,
              "tablePointerOffset": 2024422,
              "offset": 2028947,
              "bytes": 23,
              "text": "Moon Stone?{br}Never heard of it!"
            },
            {
              "id": 27,
              "tablePointerOffset": 2024246,
              "offset": 2025150,
              "bytes": 64,
              "text": "ELDER: Ha!{br}I run this town!{br}And I'm so rich I don't know what to{br}do with it all!!"
            },
            {
              "id": 28,
              "tablePointerOffset": 2024248,
              "offset": 2025214,
              "bytes": 46,
              "text": "Give you 10G if you act like{br}a chicken!{br}   Yes.{br}   No."
            },
            {
              "id": 30,
              "tablePointerOffset": 2024252,
              "offset": 2025274,
              "bytes": 32,
              "text": "ELDER: HAAAHAHA!{br}Here ya go, 10G!"
            },
            {
              "id": 29,
              "tablePointerOffset": 2024250,
              "offset": 2025260,
              "bytes": 14,
              "text": "ELDER: Bo-oring!"
            }
          ]
        }
      ]
    },
    {
      "location": 53,
      "name": "Snail Stop",
      "stringTables": [
        {
          "address": 14607104,
          "offset": 2024192
        }
      ],
      "objects": [
        {
          "object": 11,
          "npc": [
