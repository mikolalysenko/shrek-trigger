    },
    {
      "location": 62,
      "name": "Choras Inn (Present)",
      "stringTables": [
        {
          "address": 16271952,
          "offset": 3689040
        }
      ],
      "objects": [
        {
          "object": 11,
          "npc": [
            52
          ],
          "texts": [
            {
              "id": 74,
              "tablePointerOffset": 3689188,
              "offset": 3709585,
              "bytes": 38,
              "text": "Huh?{br}When do I work?{br}That's none of your business!"
            },
            {
              "id": 73,
              "tablePointerOffset": 3689186,
              "offset": 3709516,
              "bytes": 69,
              "text": "You wanna borrow my tools?{full}Be my guest!{br}I'm busy here, so go get them from my{br}wife."
            },
            {
              "id": 72,
              "tablePointerOffset": 3689184,
              "offset": 3709485,
              "bytes": 31,
              "text": "Nothing like soda pop to quench your{br}thirst!"
            },
            {
              "id": 69,
              "tablePointerOffset": 3689178,
              "offset": 3709371,
              "bytes": 20,
              "text": "Hey, bring some more soda!"
            },
            {
              "id": 71,
              "tablePointerOffset": 3689182,
              "offset": 3709424,
              "bytes": 61,
              "text": "Pipe down!{br}I'll tell you when I've had enough!{br}Can't you see I love soda pop?"
            }
          ]
        }
      ]
    },
