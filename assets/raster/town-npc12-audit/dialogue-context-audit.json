            }
          ],
          "candidates": [
            {
              "tablePointer": 14375204,
              "stringPointer": 14376389,
              "physicalOffset": 1793477,
              "text": "A beast impersonated the steward?{br}That explains the teeth.{br}I thought he had them polished.{null}"
            }
          ]
        },
        {
          "offset": 776,
          "opcode": 187,
