            }
          ],
          "candidates": [
            {
              "tablePointer": 16462956,
              "stringPointer": 16463997,
              "physicalOffset": 3881085,
              "text": "Does the queen seem different{br}to you?{br}   Yes.{br}   No.{null}"
            }
          ]
        },
        {
          "offset": 1348,
          "opcode": 187,
          "stringId": 37,
          "owners": [
            {
              "object": 10,
              "function": 1,
              "start": 1332
            }
          ],
          "candidates": [
            {
              "tablePointer": 16462956,
              "stringPointer": 16464038,
              "physicalOffset": 3881126,
              "text": "She says she is not Elowen.{br}That seems a fairly strong clue.{full}Please do not repeat that.{br}I would like to keep my job.{null}"
            }
          ]
        },
        {
          "offset": 1355,
          "opcode": 187,
          "stringId": 38,
          "owners": [
            {
              "object": 10,
              "function": 1,
              "start": 1332
            }
          ],
          "candidates": [
            {
              "tablePointer": 16462956,
              "stringPointer": 16464125,
              "physicalOffset": 3881213,
              "text": "Perhaps it is just me, then.{null}"
            }
          ]
        },
        {
          "offset": 1362,
          "opcode": 187,
          "stringId": 187,
          "owners": [
            {
              "object": 10,
              "function": 1,
              "start": 1332
            }
          ],
          "candidates": [
            {
              "tablePointer": 16462956,
              "stringPointer": 16464857,
              "physicalOffset": 3881945,
              "text": "So Elowen was somewhere else{br}the whole time.{br}I knew something was wrong.{null}"
            }
          ]
        },
        {
          "offset": 1367,
          "opcode": 187,
          "stringId": 21,
          "owners": [
            {
              "object": 10,
              "function": 1,
              "start": 1332
            }
          ],
          "candidates": [
            {
              "tablePointer": 16462956,
              "stringPointer": 16463403,
              "physicalOffset": 3880491,
              "text": "Elowen married Alder ten years{br}ago. She has hardly changed.{full}Today she looks younger still.{br}And distinctly greener.{null}"
            }
          ]
        }
      ]
