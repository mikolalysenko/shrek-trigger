          "candidates": [
            {
              "tablePointer": 14375204,
              "stringPointer": 14375875,
              "physicalOffset": 1792963,
              "text": "The steward cannot be a bad man.{br}He visits the cathedral every day.{full}That proves something, surely.{null}"
